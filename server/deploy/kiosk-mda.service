[Unit]
Description=Kiosk-MDA Config Server
After=network.target

[Service]
Type=simple
User=kiosk
WorkingDirectory=/opt/kiosk-mda/server
EnvironmentFile=/etc/kiosk-mda.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kiosk-mda

[Install]
WantedBy=multi-user.target
