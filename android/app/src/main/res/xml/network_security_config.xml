<?xml version="1.0" encoding="utf-8"?>
<!--
  Erlaubt Cleartext-HTTP fuer Self-Hosted-Server im LAN (kein TLS noetig).
  Fuer Produktion: cleartextTrafficPermitted="false" setzen und TLS-Proxy (nginx) davorschalten.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
